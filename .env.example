# App Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Firebase Configuration (Production Web App)
# Note: Next.js uses NEXT_PUBLIC_, Vite uses VITE_, and CRA uses REACT_APP_
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=inkoma-app.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=inkoma-app
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=inkoma-app.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=1:your-app-id:web:your-hash
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# Optional AI Story Generation Engine
OPENAI_API_KEY=your-openai-api-key
ELEVENLABS_API_KEY=your-elevenlabs-api-key
